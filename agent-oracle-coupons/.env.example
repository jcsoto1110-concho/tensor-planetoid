# ==============================================================================
# CONFIGURACIÓN AGENTE ORACLE RETAIL PRO (agent-oracle-coupons)
# Renombrar este archivo a .env en el servidor 192.168.91.28
# ==============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://zfbrwcflzbauycszajpc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pega_aqui_tu_service_role_key

# Conexión Oracle Retail Pro (192.168.91.14)
ORACLE_RPRO_USER=REPORTUSER
ORACLE_RPRO_PASSWORD=report
ORACLE_RPRO_CONNECT_STRING=192.168.91.14:1521/rproods

# Ruta a Oracle Instant Client (Windows o Linux según aplique en el servidor)
# En Windows: C:\SAP_Monitor\instantclient_19_22
# En Linux: /opt/oracle/instantclient_19_22 o dejar comentado si está en LD_LIBRARY_PATH
ORACLE_CLIENT_LIB=C:\SAP_Monitor\instantclient_19_22
